        "import scipy.cluster.hierarchy as sch\n",
        "from sklearn.cluster import AgglomerativeClustering\n",
        "\n",
        "# Build the linkage matrix (Ward's method minimizes within-cluster variance)\n",
        "linked = sch.linkage(X_cust, method='ward')\n",
        "\n",
        "# Plot dendrogram\n",
        "plt.figure(figsize=(14, 6))\n",
        "sch.dendrogram(linked,\n",
        "               leaf_font_size=10,\n",
        "               color_threshold=150,   # cut threshold to suggest clusters\n",
        "               above_threshold_color='grey')\n",
        "plt.title(\"Agglomerative Hierarchical Clustering Dendrogram\")\n",
        "plt.xlabel(\"Customer Index\")\n",
        "plt.ylabel(\"Ward Distance\")\n",
        "plt.axhline(y=150, color='r', linestyle='--', label=\"Suggested cut\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# Fit the model with k=5 (as suggested by the dendrogram)\n",
        "agg = AgglomerativeClustering(n_clusters=5, linkage='ward')\n",
        "labels = agg.fit_predict(X_cust)\n",
        "\n",
        "# Visualize clusters\n",
        "plt.figure(figsize=(7, 5))\n",
        "plt.scatter(X_cust[:, 0], X_cust[:, 1], c=labels, cmap='viridis',\n",
        "            s=30, alpha=0.8)\n",
        "plt.xlabel(\"Annual Income (k$)\")\n",
        "plt.ylabel(\"Spending Score (1-100)\")\n",
        "plt.title(\"Customer Segments (Agglomerative Clustering, k=5)\")\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.show()"
