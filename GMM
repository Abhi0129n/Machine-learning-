        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import scipy.stats as stats\n",
        "from sklearn.datasets import load_iris\n",
        "from sklearn.mixture import GaussianMixture\n",
        "from matplotlib.patches import Ellipse\n",
        "\n",
        "\n",
        "iris = load_iris()\n",
        "X = iris.data\n",
        "y = iris.target\n",
        "feature_names = iris.feature_names\n",
        "target_names = iris.target_names\n",
        "\n",
        "\n",
        "fig, axes = plt.subplots(2, 2, figsize=(12, 10))\n",
        "axes = axes.flatten()\n",
        "\n",
        "for i, ax in enumerate(axes):\n",
        "    for j, color in zip(range(3), ['red', 'green', 'blue']):\n",
        "\n",
        "        ax.hist(X[y == j, i], bins=15, alpha=0.6, color=color,\n",
        "                label=target_names[j], edgecolor='black', density=True)\n",
        "    ax.set_title(f'Histogram of {feature_names[i]} (3 True Gaussians)')\n",
        "    ax.set_xlabel(feature_names[i])\n",
        "    ax.set_ylabel('Density')\n",
        "    if i == 0:\n",
        "        ax.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.suptitle(\"True Gaussian Distributions in Iris Dataset (by Species)\", y=1.02, fontsize=15)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "feature_idx = 2\n",
        "X_1d = X[:, feature_idx].reshape(-1, 1)\n",
        "\n",
        "gmm_1d = GaussianMixture(n_components=3, random_state=42)\n",
        "gmm_1d.fit(X_1d)\n",
        "\n",
        "\n",
        "fitted_weights = gmm_1d.weights_\n",
        "fitted_means = gmm_1d.means_.flatten()\n",
        "fitted_stds = np.sqrt(gmm_1d.covariances_.flatten())\n",
        "\n",
        "sort_idx = np.argsort(fitted_means)\n",
        "fitted_weights = fitted_weights[sort_idx]\n",
        "fitted_means = fitted_means[sort_idx]\n",
        "fitted_stds = fitted_stds[sort_idx]\n",
        "\n",
        "x_range = np.linspace(X_1d.min() - 0.5, X_1d.max() + 0.5, 500).reshape(-1, 1)\n",
        "\n",
        "\n",
        "pdf_total = np.exp(gmm_1d.score_samples(x_range))\n",
        "pdf_components = [w * stats.norm.pdf(x_range, m, s)\n",
        "                  for w, m, s in zip(fitted_weights, fitted_means, fitted_stds)]\n",
        "\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.hist(X_1d, bins=20, density=True, alpha=0.6, color='skyblue', edgecolor='black', label='Iris Data (Petal Length)')\n",
        "\n",
        "colors = ['red', 'green', 'blue']\n",
        "for i in range(3):\n",
        "    plt.plot(x_range, pdf_components[i], color=colors[i], linewidth=2,\n",
        "             label=f'GMM Gaussian {i+1} (μ={fitted_means[i]:.2f}, σ={fitted_stds[i]:.2f})')\n",
        "\n",
        "plt.plot(x_range, pdf_total, color='black', linewidth=3, linestyle='--', label='Total GMM Fit')\n",
        "\n",
        "plt.title(f'1D Gaussian Mixture Model Fit on Iris - {feature_names[feature_idx]}', fontsize=14)\n",
        "plt.xlabel(feature_names[feature_idx])\n",
        "plt.ylabel('Density')\n",
        "plt.legend(fontsize=10)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "X_2d = X[:, [2, 3]]\n",
        "\n",
        "gmm_2d = GaussianMixture(n_components=3, random_state=42, covariance_type='full')\n",
        "gmm_2d.fit(X_2d)\n",
        "labels_2d = gmm_2d.predict(X_2d)\n",
        "\n",
        "\n",
        "def draw_ellipse(ax, mean, cov, color, scale=2):\n",
        "\n",
        "    eigenvalues, eigenvectors = np.linalg.eigh(cov)\n",
        "    angle = np.degrees(np.arctan2(eigenvectors[1, 0], eigenvectors[0, 0]))\n",
        "    width, height = 2 * np.sqrt(eigenvalues) * scale\n",
        "    ell = Ellipse(xy=mean, width=width, height=height, angle=angle,\n",
        "                  edgecolor=color, facecolor=color, alpha=0.2, linewidth=2)\n",
        "    ax.add_patch(ell)\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "scatter = plt.scatter(X_2d[:, 0], X_2d[:, 1], c=labels_2d, cmap='viridis', s=40, alpha=0.8, edgecolor='k')\n",
        "\n",
        "\n",
        "for i in range(3):\n",
        "    draw_ellipse(plt.gca(), gmm_2d.means_[i], gmm_2d.covariances_[i], color=colors[i])\n",
        "    plt.scatter(gmm_2d.means_[i, 0], gmm_2d.means_[i, 1], c=colors[i], marker='X', s=200, edgecolors='black', zorder=5)\n",
        "\n",
        "plt.title('2D GMM Clustering on Iris (Petal Length vs Width)', fontsize=14)\n",
        "plt.xlabel('Petal Length')\n",
        "plt.ylabel('Petal Width')\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "print(\"Comparison of 1D GMM Fitted Means vs. True Species Means for 'Petal Length':\")\n",
        "print(\"-\" * 70)\n",
        "true_means = [np.mean(X[y == i, feature_idx]) for i in range(3)]\n",
        "true_means_sorted = np.sort(true_means)\n",
        "\n",
        "for i in range(3):\n",
        "    print(f\"Component {i+1}: GMM Fitted Mean = {fitted_means[i]:.2f}  |  True Species Mean = {true_means_sorted[i]:.2f}\")="
      ]
