        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def kmeans_manual(X, k, max_iter=100, tol=1e-4, seed=42):\n",
        "    np.random.seed(seed)\n",
        "    n = X.shape[0]\n",
        "\n",
        "    # Initialize centroids by randomly picking k points\n",
        "    idx = np.random.choice(n, k, replace=False)\n",
        "    centroids = X[idx].copy()\n",
        "\n",
        "    history = []   # list of (iteration, centroids)\n",
        "\n",
        "    for it in range(1, max_iter + 1):\n",
        "        # --- Assignment step ---\n",
        "        # distances: (n, k)\n",
        "        dists = np.linalg.norm(X[:, None, :] - centroids[None, :, :], axis=2)\n",
        "        labels = np.argmin(dists, axis=1)\n",
        "\n",
        "        # --- Update step ---\n",
        "        new_centroids = np.array([X[labels == j].mean(axis=0)\n",
        "                                  if np.sum(labels == j) > 0\n",
        "                                  else centroids[j]\n",
        "                                  for j in range(k)])\n",
        "\n",
        "        # Record iteration\n",
        "        history.append((it, centroids.copy(), labels.copy()))\n",
        "\n",
        "        # Check convergence\n",
        "        shift = np.linalg.norm(new_centroids - centroids)\n",
        "        centroids = new_centroids\n",
        "        if shift < tol:\n",
        "            print(f\"Converged at iteration {it} (shift={shift:.6f})\")\n",
        "            break\n",
        "    else:\n",
        "        print(f\"Reached max_iter={max_iter}\")\n",
        "\n",
        "    return centroids, labels, history\n",
        "\n",
        "# Run K-means with k=5 (same k as hierarchical clustering)\n",
        "k = 5\n",
        "final_centroids, final_labels, history = kmeans_manual(X_cust, k=k)\n",
        "\n",
        "# --- Print iteration table ---\n",
        "print(f\"\\n{'Iter':<6} | {'Centroid 0':<22} | {'Centroid 1':<22} | \"\n",
        "      f\"{'Centroid 2':<22} | {'Centroid 3':<22} | {'Centroid 4':<22}\")\n",
        "print(\"-\" * 130)\n",
        "for it, cents, _ in history:\n",
        "    row = f\"{it:<6} | \" + \" | \".join(\n",
        "        f\"[{c[0]:7.2f}, {c[1]:7.2f}]\" for c in cents\n",
        "    )\n",
        "    print(row)\n",
        "\n",
        "# --- Final visualization ---\n",
        "plt.figure(figsize=(7, 5))\n",
        "plt.scatter(X_cust[:, 0], X_cust[:, 1], c=final_labels, cmap='viridis',\n",
        "            s=30, alpha=0.7, label=\"Customers\")\n",
        "plt.scatter(final_centroids[:, 0], final_centroids[:, 1],\n",
        "            c='red', marker='X', s=200, edgecolors='black',\n",
        "            label=\"Final Centroids\")\n",
        "plt.xlabel(\"Annual Income (k$)\")\n",
        "plt.ylabel(\"Spending Score (1-100)\")\n",
        "plt.title(f\"K-Means Clustering (k={k}, converged at iter {len(history)})\")\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.show()"
      ],
